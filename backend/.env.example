# Create a random local token; use the same value in desktop/.env.
MELO_LOCAL_TOKEN=
# Any OpenAI Chat Completions-compatible HTTP(S) API base URL (not the full chat endpoint).
# Z.AI is an example default, not a provider restriction. Set your provider's model ID below.
MODEL_BASE_URL=https://api.z.ai/api/paas/v4
MODEL_NAME=glm-5.3
# Configure this provider's API key locally. Never commit the real value.
MODEL_API_KEY=
LANGSMITH_TRACING=false
# LangSmith monitoring is optional and always hides message bodies.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=melo
LANGSMITH_WORKSPACE_ID=
# For new agent-based workspaces, create an Observability agent and use its ID.
# Agent ID takes priority over LANGSMITH_PROJECT in this application.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=development
